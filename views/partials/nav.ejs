<nav class="main-nav" aria-label="Primary navigation">
  <ul class="nav-list">
    <!-- Guest/Public navigation -->
    <li class="guest-nav-item">
      <a href="/" class="<%= page === 'home' ? 'active' : '' %>">Home</a>
    </li>

    <li class="guest-nav-item">
      <a href="/about" class="<%= page === 'about' ? 'active' : '' %>">About</a>
    </li>

    <li class="guest-nav-item">
      <a href="/login" class="<%= page === 'login' ? 'active' : '' %>">Login</a>
    </li>

    <li class="guest-nav-item">
      <a href="/register" class="<%= page === 'register' ? 'active' : '' %>">Register</a>
    </li>

    <!-- Logged-in navigation -->
    <li class="auth-nav-item" style="display: none;">
      <a href="/dashboard" class="<%= page === 'dashboard' ? 'active' : '' %>">Dashboard</a>
    </li>

    <li class="auth-nav-item" style="display: none;">
      <a href="/parts-list" class="<%= page === 'parts-list' ? 'active' : '' %>">Parts</a>
    </li>

    <li class="auth-nav-item" style="display: none;">
      <a href="/checkouts" class="<%= page === 'checkouts' ? 'active' : '' %>">Checkouts</a>
    </li>

    <li class="auth-nav-item" style="display: none;">
      <a href="/transactions-log" class="<%= page === 'transactions-log' ? 'active' : '' %>">Transactions</a>
    </li>

    <li class="auth-nav-item" style="display: none;">
      <a href="/reports" class="<%= page === 'reports' ? 'active' : '' %>">Reports</a>
    </li>

    <li class="auth-nav-item" style="display: none;">
      <a href="/admin/dashboard" class="<%= page === 'admin-dashboard' ? 'active' : '' %>">Admin</a>
    </li>

    <li class="auth-nav-item" style="display: none;">
      <a href="#" class="logout-link">Logout</a>
    </li>
  </ul>
</nav>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const savedToken = localStorage.getItem("partvault_token");
    const guestItems = document.querySelectorAll(".guest-nav-item");
    const authItems = document.querySelectorAll(".auth-nav-item");
    const logoutLinks = document.querySelectorAll(".logout-link");

    if (savedToken) {
      guestItems.forEach((item) => {
        item.style.display = "none";
      });

      authItems.forEach((item) => {
        item.style.display = "";
      });
    } else {
      guestItems.forEach((item) => {
        item.style.display = "";
      });

      authItems.forEach((item) => {
        item.style.display = "none";
      });
    }

    logoutLinks.forEach((logoutLink) => {
      logoutLink.addEventListener("click", function (event) {
        event.preventDefault();

        localStorage.removeItem("partvault_token");
        localStorage.removeItem("partvault_user");

        window.location.href = "/login";
      });
    });
  });
</script>