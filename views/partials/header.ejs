<header class="site-header">
  <div class="container header-inner">
    <div class="brand-area">
      <a href="/" class="site-brand">PartVault Inventory</a>
      <p class="site-tagline">Track parts. Manage checkouts. Stay organized.</p>
    </div>

    <button
      class="nav-toggle"
      id="navToggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobileNav"
      aria-label="Toggle navigation"
    >
      ☰
    </button>

    <div class="desktop-nav">
      <%- include("nav", { page: page }) %>
    </div>

    <div class="account-menu">
      <a href="/login" class="account-label" id="accountLabel" style="text-decoration: none;">Guest</a>
    </div>
  </div>

  <div class="mobile-nav-wrapper" id="mobileNav">
    <div class="container">
      <%- include("nav", { page: page }) %>
    </div>
  </div>
</header>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const accountLabel = document.getElementById("accountLabel");
    const savedUser = localStorage.getItem("partvault_user");

    if (!accountLabel) {
      return;
    }

    if (!savedUser) {
      accountLabel.textContent = "Guest";
      accountLabel.href = "/login";
      return;
    }

    try {
      const user = JSON.parse(savedUser);

      accountLabel.textContent = user.username || user.email || "User";
      accountLabel.href = "/profile";
      accountLabel.title = "View Profile";
    } catch (error) {
      accountLabel.textContent = "Guest";
      accountLabel.href = "/login";
    }
  });
</script>